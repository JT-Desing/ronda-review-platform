# Cloudflare R2 through restic. Copy to .env.offsite and fill in; never commit it.
# One repository path per deployment, e.g. .../ronda-backups/epayco-mkt
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/ronda-backups/DEPLOYMENT
# R2 API token scoped to this bucket with "Object Read & Write".
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Encrypts every backup. Without it the backups cannot be restored:
# store it in the team's password manager before the first run.
RESTIC_PASSWORD=
# Optional. Default 21600 (every 6 hours).
OFFSITE_INTERVAL_SECONDS=21600
