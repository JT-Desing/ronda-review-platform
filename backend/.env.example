POSTGRES_USER=ronda
POSTGRES_DB=ronda
# Use bootstrap.js to generate the real local secrets; do not use placeholders.
POSTGRES_PASSWORD=
DATABASE_URL=
APP_ORIGIN=https://ronda.repolite.link
# Optional. Configure a Google OAuth web client with this redirect:
# https://ronda.repolite.link/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP credentials belong only in the private .env; never commit real values.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
