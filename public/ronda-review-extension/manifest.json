{
  "manifest_version": 3,
  "name": "Ronda · Comentarios web",
  "description": "Ancla comentarios de Ronda al contenido de páginas web que autorizas.",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*"],
  "action": {
    "default_title": "Conectar esta web con Ronda",
    "default_popup": "popup.html"
  }
}
