---
import { plans, monthlyPrice, formatPrice, perSeatComparison, PER_SEAT_REFERENCE_USD } from '../data/plans.js';
import { SIGNUP_URL, SALES_EMAIL } from '../data/site.js';
const start = perSeatComparison(5);
const hrefFor = (id: string) => (id === 'gratis' ? SIGNUP_URL : `mailto:${SALES_EMAIL}?subject=${encodeURIComponent(`Plan ${plans.find((p) => p.id === id)!.name} de Ronda`)}`);
---
<section class="section pricing" id="precios" aria-labelledby="precios-titulo">
  <div class="wrap">
    <div class="section-head">
      <h2 id="precios-titulo">Un precio por equipo, no por persona</h2>
      <p>Las herramientas de revisión más conocidas cobran cada puesto. En Ronda pagas el plan del espacio y sumas gente sin que la factura crezca.</p>
    </div>

    <div class="calc" data-calc>
      <label for="personas">¿Cuántas personas revisan?</label>
      <div class="calc-row">
        <input id="personas" type="range" min="1" max="15" value={start.members} data-members />
        <output for="personas" data-members-out>{start.members}</output>
      </div>
      <dl class="calc-result">
        <div><dt>Cobro por persona a USD {PER_SEAT_REFERENCE_USD}</dt><dd data-perseat>USD {start.perSeat}</dd></div>
        <div class="calc-ronda"><dt data-plan-label>Ronda {start.plan.name}</dt><dd data-ronda>USD {start.ronda}</dd></div>
      </dl>
      <p class="calc-note" data-saving>Ahorras USD {start.saving} al mes.</p>
    </div>

    <div class="switches">
      <div class="seg" role="group" aria-label="Periodo de pago">
        <button type="button" aria-pressed="true" data-billing="monthly">Mensual</button>
        <button type="button" aria-pressed="false" data-billing="annual">Anual, 2 meses gratis</button>
      </div>
      <div class="seg" role="group" aria-label="Moneda">
        <button type="button" aria-pressed="true" data-currency="COP">COP</button>
        <button type="button" aria-pressed="false" data-currency="USD">USD</button>
      </div>
    </div>

    <ul class="plans">
      {plans.map((plan) => (
        <li class:list={['plan', { featured: plan.featured }]}>
          <h3>{plan.name}</h3>
          <p class="summary">{plan.summary}</p>
          <p class="price">
            <span class="amount" data-price={plan.id}>{formatPrice(monthlyPrice(plan), 'COP')}</span>
            {plan.price.USD > 0 && <span class="per" data-per={plan.id}>al mes</span>}
          </p>
          <a class:list={['btn', { 'btn-primary': plan.featured }]} href={hrefFor(plan.id)}>{plan.cta}</a>
          <ul class="features">{plan.features.map((f) => <li>{f}</li>)}</ul>
        </li>
      ))}
    </ul>
    <p class="fine">Precios de lanzamiento. Mientras terminamos el pago en línea, activamos los planes pagos por correo.</p>
  </div>
</section>

<style>
  .calc{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:12px 48px;align-items:center;padding:28px;margin-bottom:48px;border-radius:18px;background:var(--surface-1);border:1px solid var(--line)}
  .calc label{font-size:15px;color:var(--muted)}
  .calc-row{display:flex;align-items:center;gap:16px;grid-column:1}
  .calc-row input{flex:1;accent-color:var(--lavender);height:28px}
  .calc-row output{min-width:2ch;font-size:40px;font-weight:600;letter-spacing:-.04em;font-variant-numeric:tabular-nums}
  .calc-result{grid-column:2;grid-row:1/3;display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:0}
  .calc-result div{padding:16px 18px;border-radius:14px;background:var(--surface-2)}
  .calc-result .calc-ronda{background:var(--lavender);color:var(--primary-text)}
  .calc-result dt{font-size:13px;opacity:.8}
  .calc-result dd{margin:4px 0 0;font-size:clamp(26px,3vw,34px);font-weight:600;letter-spacing:-.03em;font-variant-numeric:tabular-nums}
  .calc-result div:first-child dd{text-decoration:line-through;text-decoration-thickness:2px;text-decoration-color:var(--coral)}
  .calc-note{grid-column:1/-1;font-size:14px;color:var(--success)}

  .switches{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:20px}
  .seg{display:inline-flex;padding:4px;border-radius:999px;background:var(--surface-1);border:1px solid var(--line)}
  .seg button{min-height:40px;padding:0 16px;border:0;border-radius:999px;background:transparent;color:var(--muted);font-size:14px;cursor:pointer}
  .seg button[aria-pressed=true]{background:var(--surface-3);color:var(--text)}

  .plans{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:0;padding:0;list-style:none}
  .plan{display:flex;flex-direction:column;padding:24px;border-radius:14px;border:1px solid var(--line)}
  .plan.featured{background:var(--surface-2);border-color:var(--lavender);box-shadow:0 30px 80px -40px rgb(200 177 245 / .5)}
  .plan h3{font-size:20px;letter-spacing:-.02em}
  .summary{margin-top:6px;min-height:3em;font-size:14px;color:var(--muted)}
  .price{display:flex;align-items:baseline;flex-wrap:wrap;gap:6px;margin:20px 0}
  .amount{font-size:32px;font-weight:600;letter-spacing:-.04em;font-variant-numeric:tabular-nums}
  .per{font-size:13px;color:var(--faint)}
  .plan .btn{width:100%}
  .features{display:grid;gap:10px;margin:22px 0 0;padding:0;list-style:none;font-size:14px;color:var(--muted)}
  .features li{display:flex;gap:10px}
  .features li::before{content:'';flex:none;width:6px;height:6px;margin-top:.55em;border-radius:50%;background:var(--lavender)}
  .fine{margin-top:20px;font-size:13px;color:var(--faint)}

  @media (max-width:1060px){.plans{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media (max-width:760px){
    .calc{grid-template-columns:1fr;padding:20px}
    .calc-result{grid-column:1;grid-row:auto}
  }
  @media (max-width:560px){.plans{grid-template-columns:1fr}.summary{min-height:0}.calc-result{grid-template-columns:1fr}}
</style>

<script>
  import { plans, monthlyPrice, annualTotal, formatPrice, perSeatComparison } from '../data/plans.js';

  const root = document.getElementById('precios')!;
  const members = root.querySelector<HTMLInputElement>('[data-members]')!;
  const out = (sel: string) => root.querySelector<HTMLElement>(sel)!;
  let currency: 'COP' | 'USD' = 'COP', billing: 'monthly' | 'annual' = 'monthly';

  function paintCalc() {
    const r = perSeatComparison(Number(members.value));
    out('[data-members-out]').textContent = String(r.members);
    out('[data-perseat]').textContent = `USD ${r.perSeat}`;
    out('[data-plan-label]').textContent = `Ronda ${r.plan.name}`;
    out('[data-ronda]').textContent = `USD ${r.ronda}`;
    out('[data-saving]').textContent = r.saving > 0 ? `Ahorras USD ${r.saving} al mes.` : 'Para una sola persona el precio es parecido; la diferencia aparece al sumar equipo.';
  }

  function paintPlans() {
    for (const plan of plans) {
      out(`[data-price="${plan.id}"]`).textContent = formatPrice(monthlyPrice(plan, { currency, billing }), currency);
      const per = root.querySelector<HTMLElement>(`[data-per="${plan.id}"]`);
      if (per) per.textContent = billing === 'annual' ? `al mes, ${formatPrice(annualTotal(plan, currency), currency)} al año` : 'al mes';
    }
  }

  const bind = (attr: string, apply: (value: string) => void) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>(`[${attr}]`);
    buttons.forEach((button) => button.addEventListener('click', () => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      apply(button.getAttribute(attr)!);
      paintPlans();
    }));
  };
  bind('data-billing', (v) => { billing = v as typeof billing; });
  bind('data-currency', (v) => { currency = v as typeof currency; });
  members.addEventListener('input', paintCalc);
  paintCalc();
</script>
